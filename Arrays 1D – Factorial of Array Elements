Hc-Arrays 1D – Factorial of Array Elements
import java.io.*;
import java.util.*;

public class Solution {
    static void fact(int a)
    {int fact=1;
        for(int i=a;i>0;i--)
        {
            fact=fact*i;
        }
        if(a==0)
        {
            System.out.print("1"+" ");
        }
        else{
        System.out.print(fact+" ");
    }}

    public static void main(String[] args) {
    Scanner sc=new Scanner (System.in);
    int n=sc.nextInt();
    int arr[]=new int[n];
    for(int i=0;i<n;i++)
    {
        arr[i]=sc.nextInt();
    }
    for(int i=0;i<n;i++)
    {
        fact(arr[i]);
    }
    }
}
