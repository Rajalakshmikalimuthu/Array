import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
     Scanner sc=new Scanner(System.in);
     int n=sc.nextInt();
     int arr[]=new int[n];
     for(int i=0;i<n;i++)
     {
        arr[i]=sc.nextInt();
     }
     Arrays.sort(arr);
     int l=0;
     int r=n-1;
     while(l<r)
     {
        System.out.print(arr[r]+" ");
        System.out.println(arr[l]+" ");
        l++;
        r--;
     }
     if(l==r)
     {
        System.out.println(arr[l]+" 0 ");
     }
    }
}
